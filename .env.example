DATABASE_URL=postgres://ragbench:ragbench@localhost:5433/ragbench
# Where uploaded documents are stored. Web writes them and the worker reads them, so both
# processes must resolve this to the same directory (defaults to <cwd>/uploads, which differs
# per app when they are started from their own directories).
RAGBENCH_UPLOADS_DIR=
AUTH_SECRET=change-me
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

DATABASE_URL=postgres://ragbench:ragbench@localhost:5433/ragbench
# Where the test suites write. Defaults to a database of its own on the same compose cluster,
# created and migrated automatically on the first `pnpm test`, so tests never collide with the dev
# database a running worker is polling for jobs.
TEST_DATABASE_URL=postgres://ragbench:ragbench@localhost:5433/ragbench_test
# Where `pnpm e2e` (Playwright, demo mode) writes. A third database of its own, distinct from both
# the dev database and TEST_DATABASE_URL above -- the e2e web and worker processes it spawns run
# for the whole suite, unlike the vitest suites' short-lived connections, so sharing either would
# risk a leftover e2e project showing up in a dev smoke test or racing the vitest suites' own runs.
# Created and migrated automatically by `pnpm e2e` before the servers start.
E2E_DATABASE_URL=postgres://ragbench:ragbench@localhost:5433/ragbench_e2e
# Where uploaded documents are stored. Web writes them and the worker reads them, so both
# processes must resolve this to the same directory (defaults to <cwd>/uploads, which differs
# per app when they are started from their own directories).
RAGBENCH_UPLOADS_DIR=
# How many evaluate-question jobs the worker runs at once (default 4, clamped to 1..8). Each is one
# query embed plus up to two LLM calls, so this is the knob for how hard a run leans on the
# provider's rate limit. Every other queue stays serial regardless.
RAGBENCH_EVAL_CONCURRENCY=
AUTH_SECRET=change-me
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

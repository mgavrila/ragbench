{
  "name": "ragbench",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @ragbench/db migrate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json --noEmit",
    "e2e": "tsx e2e/prepare-db.ts && playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@ragbench/db": "workspace:*",
    "@types/node": "^26.4.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
